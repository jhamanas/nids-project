# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# --- Virtual environments ---
venv/
.venv/
env/

# --- Datasets (large, not committed — see data/raw/*/README.md for download steps) ---
data/raw/cicids2017/*
data/raw/nsl-kdd/*
!data/raw/cicids2017/.gitkeep
!data/raw/cicids2017/README.md
!data/raw/nsl-kdd/.gitkeep
!data/raw/nsl-kdd/README.md
data/processed/*
!data/processed/.gitkeep

# --- Test fixtures: keep the synthetic sample PCAP, it's small and deterministic ---
!tests/fixtures/sample.pcap

# --- Model artifacts ---
models/*.pkl
models/*.pt
models/*.h5
!models/.gitkeep

# --- Logs ---
logs/*.log
logs/*.json
!logs/.gitkeep

# --- OS / editor cruft ---
.DS_Store
.vscode/
.idea/
